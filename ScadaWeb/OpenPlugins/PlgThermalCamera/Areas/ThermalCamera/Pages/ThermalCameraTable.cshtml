@page "{id:int?}"
@model Scada.Web.Plugins.PlgThermalCamera.Areas.ThermalCamera.Pages.ThermalCameraTableModel
@{
    Layout = "_BasicLayout";
}

@section Styles {
    <link href="~/plugins/ThermalCamera/css/thermal-camera.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="~/plugins/ThermalCamera/js/thermal-camera.js" asp-append-version="true"></script>
    <script id="tcItems" type="application/json">@Html.Raw(Model.ItemsJson)</script>
    <script id="tcUserData" type="application/json">@Html.Raw(Model.UserDataJson)</script>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger m-3" role="alert">
        @Model.ErrorMessage
    </div>
}
else
{
    <div class="tc-container" data-view-id="@Model.ViewID" data-is-admin="@(Model.IsAdmin ? "1" : "0")">
        <div class="tc-header">
            <div class="tc-header-controls">
                <span id="spanServerTime" class="tc-server-time">--:--:--</span>
                <button id="btnRefresh" class="tc-refresh-btn" title="Обновить данные">
                    <i class="fa-solid fa-arrows-rotate"></i>
                    <span>Обновить</span>
                </button>
                <div class="tc-district-filter dropdown">
                    <button class="btn btn-sm tc-district-btn dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <i class="fa-solid fa-map-location-dot"></i>
                        <span id="tcDistrictLabel">Районы 6/6</span>
                    </button>
                    <ul class="dropdown-menu tc-district-menu">
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="1" checked>
                            <span>Район 1</span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="2" checked>
                            <span>Район 2</span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="3" checked>
                            <span>Район 3</span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="4" checked>
                            <span>Район 4</span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="5" checked>
                            <span>Район 5</span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="6" checked>
                            <span>Район 6</span>
                        </label></li>
                    </ul>
                </div>
                <div class="tc-search-wrapper">
                    <i class="fa-solid fa-magnifying-glass tc-search-icon"></i>
                    <input id="tcSearchInput" class="tc-search-input" type="text"
                           placeholder="Поиск" autocomplete="off" />
                </div>
            </div>
            <h4 class="tc-title"><i class="fa-solid fa-temperature-half"></i> Тепловые камеры мониторинг</h4>
        </div>

        <div class="tc-table-wrapper">
            <table class="table table-bordered table-hover tc-table" id="tblThermalCameras">
                <thead class="table-dark">
                    <tr>
                        <th class="tc-col-district">
                            <i class="fa-solid fa-map-location-dot"></i> Район
                        </th>
                        <th class="tc-col-name">
                            <i class="fa-solid fa-tag"></i> Объект ТК
                        </th>
                        <th class="tc-col-address">
                            <i class="fa-solid fa-location-dot"></i> Адрес
                        </th>
                        <th class="tc-col-online">
                            <i class="fa-solid fa-wifi"></i> Связь
                        </th>
                        <th class="tc-col-flooding">
                            <i class="fa-solid fa-water"></i> Состояние затопления
                        </th>
                        <th class="tc-col-battery">
                            <i class="fa-solid fa-battery-half"></i> Батарея
                        </th>
                        <th class="tc-col-comment">
                            <i class="fa-solid fa-comment"></i> Комментарий
                        </th>
                        <th class="tc-col-status">
                            <i class="fa-solid fa-circle-check"></i> В работе
                        </th>
                    </tr>
                </thead>
                <tbody id="tbodyThermalCameras">
                    <!-- Rows generated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Photo Modal -->
    <div class="modal fade" id="photoModal" tabindex="-1" aria-labelledby="photoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="photoModalLabel">Фото объекта</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="imgPhoto" src="" alt="Фото объекта" class="img-fluid tc-photo-img" />
                    <div id="divPhotoError" class="text-danger mt-2 d-none">Фото не найдено</div>
                </div>
            </div>
        </div>
    </div>
}
