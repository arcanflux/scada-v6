@page "{id:int?}"
@model Scada.Web.Plugins.PlgThermalCamera.Areas.ThermalCamera.Pages.ThermalCameraTableModel
@{
    Layout = "_BasicLayout";
}

@section Styles {
    <link href="~/plugins/ThermalCamera/css/thermal-camera.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/plugins/ThermalCamera/css/tc-flood-history.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="~/plugins/ThermalCamera/js/tc-flood-history.js" asp-append-version="true"></script>
    <script src="~/plugins/ThermalCamera/js/thermal-camera.js" asp-append-version="true"></script>
    <script id="tcItems" type="application/json">@Html.Raw(Model.ItemsJson)</script>
    <script id="tcUserData" type="application/json">@Html.Raw(Model.UserDataJson)</script>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger m-3" role="alert">
        @Model.ErrorMessage
    </div>
}
else
{
    <div class="tc-container"
         data-view-id="@Model.ViewID"
         data-is-admin="@(Model.IsAdmin ? "1" : "0")"
         data-main-view-id="@Model.MainViewID"
         data-main-view-frame="@Url.Content(Model.MainViewFrameUrl)"
         data-main-view-page="@Url.Content(Model.MainViewPageUrl)"
         data-map-view-id="@Model.MapViewID"
         data-map-view-frame="@Url.Content(Model.MapViewFrameUrl)"
         data-map-view-page="@Url.Content(Model.MapViewPageUrl)">
        <div class="tc-header">
            <div class="tc-header-controls">
                @if (Model.MainViewID > 0)
                {
                    <button class="btn btn-sm tc-nav-btn" id="btnNavMain">
                        <i class="fa-solid fa-house"></i> Главный экран
                    </button>
                }
                @if (Model.MapViewID > 0)
                {
                    <button class="btn btn-sm tc-nav-btn" id="btnNavMap">
                        <i class="fa-solid fa-map"></i> Карта
                    </button>
                }
                <div class="tc-district-filter dropdown">
                    <button class="btn btn-sm tc-district-btn dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <i class="fa-solid fa-map-location-dot"></i>
                        <span id="tcDistrictLabel">Районы 6/6</span>
                    </button>
                    <ul class="dropdown-menu tc-district-menu">
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="1" checked>
                            <span>Район 1</span><span class="tc-district-count" data-district="1"></span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="2" checked>
                            <span>Район 2</span><span class="tc-district-count" data-district="2"></span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="3" checked>
                            <span>Район 3</span><span class="tc-district-count" data-district="3"></span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="4" checked>
                            <span>Район 4</span><span class="tc-district-count" data-district="4"></span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="5" checked>
                            <span>Район 5</span><span class="tc-district-count" data-district="5"></span>
                        </label></li>
                        <li><label class="dropdown-item tc-district-option">
                            <input type="checkbox" class="form-check-input tc-district-cb" value="6" checked>
                            <span>Район 6</span><span class="tc-district-count" data-district="6"></span>
                        </label></li>
                    </ul>
                </div>
                <div class="tc-search-wrapper">
                    <i class="fa-solid fa-magnifying-glass tc-search-icon"></i>
                    <input id="tcSearchInput" class="tc-search-input" type="text"
                           placeholder="Поиск" autocomplete="off" />
                </div>
            </div>
            <span id="spanServerTime" class="tc-server-time">--:--:--</span>
            <div id="tcHdrOnlineStats" class="tc-hdr-stat-block"
                 data-tc-hint="○ Белый · Всего ТК&#10;● Зелёный · Со связью&#10;● Красный · Без связи&#10;Только активные каналы (в работе)">
                <div class="tc-hdr-stat-row"><span class="tc-hdr-dot tc-hdr-dot-total"></span><span id="tcHdrTotal">—</span><span class="tc-hdr-stat-label">Всего</span></div>
                <div class="tc-hdr-stat-row"><span class="tc-hdr-dot tc-hdr-dot-online"></span><span id="tcHdrOnline">—</span><span class="tc-hdr-stat-label">Связь</span></div>
                <div class="tc-hdr-stat-row"><span class="tc-hdr-dot tc-hdr-dot-offline"></span><span id="tcHdrOffline">—</span><span class="tc-hdr-stat-label">Нет связи</span></div>
            </div>
            <div id="tcHdrFlood200Stats" class="tc-hdr-stat-block"
                 data-tc-hint="● Зелёный · Норма 200мм&#10;● Жёлтый · Затопление 200мм&#10;Только активные каналы (в работе)">
                <div class="tc-hdr-stat-row"><span class="tc-hdr-dot tc-hdr-dot-normal"></span><span id="tcHdrNorm200">—</span><span class="tc-hdr-stat-label">Норма</span></div>
                <div class="tc-hdr-stat-row"><span class="tc-hdr-dot tc-hdr-dot-flood200"></span><span id="tcHdrFlood200cnt">—</span><span class="tc-hdr-stat-label">Затопл.</span></div>
            </div>
            <div id="tcHdrFlood700Stats" class="tc-hdr-stat-block"
                 data-tc-hint="● Зелёный · Норма 700мм&#10;● Красный · Затопление 700мм&#10;Только активные каналы (в работе)">
                <div class="tc-hdr-stat-row"><span class="tc-hdr-dot tc-hdr-dot-normal"></span><span id="tcHdrNorm700">—</span><span class="tc-hdr-stat-label">Норма</span></div>
                <div class="tc-hdr-stat-row"><span class="tc-hdr-dot tc-hdr-dot-flood700"></span><span id="tcHdrFlood700cnt">—</span><span class="tc-hdr-stat-label">Затопл.</span></div>
            </div>
        </div>

        <div class="tc-table-wrapper">
            <table class="table table-bordered table-hover tc-table" id="tblThermalCameras">
                <thead class="table-dark">
                    <tr>
                        <th class="tc-col-status">
                            <i class="fa-solid fa-circle-check"></i> В работе
                        </th>
                        <th class="tc-col-district">
                            <i class="fa-solid fa-map-location-dot"></i> Район
                            <button id="btnSortDistrict" class="tc-tbl-sort-btn" title="Сортировка по районам">
                            </button>
                        </th>
                        <th class="tc-col-name">
                            <i class="fa-solid fa-tag"></i> Объект ТК
                        </th>
                        <th class="tc-col-address">
                            <i class="fa-solid fa-location-dot"></i> Адрес
                        </th>
                        <th class="tc-col-online">
                            <i class="fa-solid fa-wifi"></i> Связь
                            <button id="btnSortOnline" class="tc-tbl-sort-btn" title="Сортировка по связи">
                            </button>
                        </th>
                        <th class="tc-col-flooding">
                            <i class="fa-solid fa-water"></i> Состояние затопления
                            <button id="btnSortFloodState" class="tc-tbl-sort-btn" title="Сортировка по состоянию затопления">
                                <i class="fa-solid fa-water"></i>
                            </button>
                            <button id="btnSortTemp" class="tc-tbl-sort-btn" title="Сортировка по температуре">
                                <i class="fa-solid fa-thermometer-half"></i>
                            </button>
                        </th>
                        @* Battery column hidden — keep markup for easy restore.
                        <th class="tc-col-battery">
                            <i class="fa-solid fa-battery-half"></i> Батарея
                            <button id="btnSortBattery" class="tc-tbl-sort-btn" title="Сортировка по батарее">
                            </button>
                        </th>
                        *@
                        <th class="tc-col-journal">
                            <i class="fa-solid fa-book-open"></i> Журнал
                        </th>
                    </tr>
                </thead>
                <tbody id="tbodyThermalCameras">
                    <!-- Rows generated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Photo Modal -->
    <div id="tcPhotoModal" class="tc-photo-overlay">
        <div class="tc-photo-panel">
            <div class="tc-fh-header">
                <span id="tcPhotoTitle" class="tc-fh-header-title">Фото объекта</span>
                <button type="button" class="tc-menu-close" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="tc-photo-body">
                <img id="imgPhoto" src="" alt="Фото объекта" class="tc-photo-img-full" />
                <div id="divPhotoError" class="tc-photo-error d-none">Фото не найдено</div>
            </div>
        </div>
    </div>

    <!-- Flood History Modal -->
    <div id="tcFloodHistoryModal" class="tc-flood-history-overlay">
        <div class="tc-fh-panel">
            <div class="tc-fh-header">
                <span id="tcFloodHistoryTitle" class="tc-fh-header-title">История затоплений</span>
                <button type="button" class="tc-menu-close" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="tc-fh-toolbar">
                <label for="tcFloodHistoryYear">Год:</label>
                <select id="tcFloodHistoryYear"></select>
            </div>
            <div id="tcFloodHistoryBody" class="tc-fh-body">
                <div class="tc-fh-loading">Загрузка...</div>
            </div>
        </div>
    </div>
}
