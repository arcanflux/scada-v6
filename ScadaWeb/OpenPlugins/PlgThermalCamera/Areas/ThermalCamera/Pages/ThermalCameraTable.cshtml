@page "{id:int?}"
@model Scada.Web.Plugins.PlgThermalCamera.Areas.ThermalCamera.Pages.ThermalCameraTableModel
@{
    Layout = "_BasicLayout";
}

@section Styles {
    <link href="~/plugins/ThermalCamera/css/thermal-camera.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="~/plugins/ThermalCamera/js/thermal-camera.js" asp-append-version="true"></script>
    <script id="tcItems" type="application/json">@Html.Raw(Model.ItemsJson)</script>
    <script id="tcUserData" type="application/json">@Html.Raw(Model.UserDataJson)</script>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger m-3" role="alert">
        @Model.ErrorMessage
    </div>
}
else
{
    <div class="tc-container">
        <div class="tc-header">
            <h4 class="tc-title">
                <i class="fa-solid fa-temperature-half"></i>
                Тепловые камеры - мониторинг
            </h4>
            <div class="tc-toolbar">
                <span id="spanServerTime" class="tc-server-time"></span>
                <button id="btnRefresh" class="btn btn-sm btn-outline-secondary" title="Обновить данные">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </button>
            </div>
        </div>

        <div class="tc-table-wrapper">
            <table class="table table-bordered table-hover tc-table" id="tblThermalCameras">
                <thead class="table-dark">
                    <tr>
                        <th class="tc-col-district" title="Номер района для сортировки">
                            <i class="fa-solid fa-map-location-dot"></i> Район
                        </th>
                        <th class="tc-col-name" title="Имя объекта тепловой камеры">
                            <i class="fa-solid fa-tag"></i> Объект ТК
                        </th>
                        <th class="tc-col-address" title="Реальный адрес объекта">
                            <i class="fa-solid fa-location-dot"></i> Адрес
                        </th>
                        <th class="tc-col-online" title="Канал связи - Online статус">
                            <i class="fa-solid fa-wifi"></i> Связь
                        </th>
                        <th class="tc-col-flooding" title="Состояния затопления с температурой">
                            <i class="fa-solid fa-water"></i> Состояние затопления
                        </th>
                        <th class="tc-col-comment" title="Комментарии (сохраняются в плагине)">
                            <i class="fa-solid fa-comment"></i> Комментарий
                        </th>
                        <th class="tc-col-status" title="Введено в работу (сохраняется в плагине)">
                            <i class="fa-solid fa-circle-check"></i> В работе
                        </th>
                    </tr>
                </thead>
                <tbody id="tbodyThermalCameras">
                    <!-- Rows generated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Photo Modal -->
    <div class="modal fade" id="photoModal" tabindex="-1" aria-labelledby="photoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="photoModalLabel">Фото объекта</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="imgPhoto" src="" alt="Фото объекта" class="img-fluid tc-photo-img" />
                    <div id="divPhotoError" class="text-danger mt-2 d-none">Фото не найдено</div>
                </div>
            </div>
        </div>
    </div>
}
