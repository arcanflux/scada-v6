<?xml version="1.0" encoding="utf-8"?>
<!--
  Пример конфигурации плагина тепловых камер.
  Скопируйте этот файл в папку Interface проекта и укажите тип представления ThermalCameraTableView.

  Каждый элемент ThermalCamera описывает один объект ТК:
    id - уникальный идентификатор
    districtNumber - номер района (для сортировки)
    name - имя объекта ТК
    address - реальный адрес объекта
    photoUrl - URL фото объекта (относительный или абсолютный)
    onlineCnlNum - номер канала для статуса Online

  Каждый FloodingSignal описывает один сигнал затопления:
    label - метка сигнала (Т1, Т2, ОТ1, ОТ2 и т.д.)
    statusCnlNum - номер канала статуса затопления (0 = норма, 1 = затоплено)
    temperatureCnlNum - номер канала температуры
-->
<ThermalCameraConfig>
  <ThermalCamera id="1" districtNumber="1" name="ТК-001"
    address="ул. Ленина, 15" photoUrl="/images/tk/tk-001.jpg"
    onlineCnlNum="101" comment="" isCommissioned="true">
    <FloodingSignal label="Т1" statusCnlNum="201" temperatureCnlNum="301" />
    <FloodingSignal label="Т2" statusCnlNum="202" temperatureCnlNum="302" />
    <FloodingSignal label="ОТ1" statusCnlNum="203" temperatureCnlNum="303" />
    <FloodingSignal label="ОТ2" statusCnlNum="204" temperatureCnlNum="304" />
  </ThermalCamera>
  <ThermalCamera id="2" districtNumber="1" name="ТК-002"
    address="ул. Мира, 42" photoUrl="/images/tk/tk-002.jpg"
    onlineCnlNum="102" comment="" isCommissioned="false">
    <FloodingSignal label="Т1" statusCnlNum="211" temperatureCnlNum="311" />
    <FloodingSignal label="Т2" statusCnlNum="212" temperatureCnlNum="312" />
  </ThermalCamera>
  <ThermalCamera id="3" districtNumber="2" name="ТК-003"
    address="пр. Победы, 8" photoUrl="/images/tk/tk-003.jpg"
    onlineCnlNum="103" comment="" isCommissioned="true">
    <FloodingSignal label="Т1" statusCnlNum="221" temperatureCnlNum="321" />
    <FloodingSignal label="Т2" statusCnlNum="222" temperatureCnlNum="322" />
    <FloodingSignal label="ОТ1" statusCnlNum="223" temperatureCnlNum="323" />
  </ThermalCamera>
</ThermalCameraConfig>
