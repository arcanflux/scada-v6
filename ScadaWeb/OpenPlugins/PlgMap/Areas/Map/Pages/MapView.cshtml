@page "{id:int?}"
@model Scada.Web.Plugins.PlgMap.Areas.Map.Pages.MapViewModel
@{
    Layout = "_BasicLayout";
}

@section Styles {
    <style>
        html, body {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .map-container {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 1;
        }

        .map-marker-icon {
            background: none !important;
            border: none !important;
        }

        .map-popup-table {
            border-collapse: collapse;
            font-size: 0.9em;
            margin: 4px 0;
        }

        .map-popup-table td {
            padding: 1px 6px 1px 0;
        }

        .map-popup-table .alias {
            color: #666;
        }

        .map-popup-table .val {
            font-weight: 600;
        }

        .map-popup-chart-link {
            display: inline-block;
            margin-top: 4px;
            font-size: 0.85em;
            cursor: pointer;
            color: #0073aa;
            text-decoration: none;
        }

        .map-popup-chart-link:hover {
            text-decoration: underline;
        }

        .leaflet-control-attribution {
            display: none !important;
        }

        /* Search bar */
        .map-search-container {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            width: 320px;
        }

        .map-search-input {
            width: 100%;
            padding: 8px 12px;
            border: 2px solid rgba(0,0,0,0.2);
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            box-shadow: 0 1px 5px rgba(0,0,0,0.2);
            box-sizing: border-box;
        }

        .map-search-input:focus {
            border-color: #0073aa;
        }

        .map-search-results {
            background: #fff;
            border: 1px solid #ccc;
            border-top: none;
            border-radius: 0 0 4px 4px;
            max-height: 250px;
            overflow-y: auto;
            display: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .map-search-results.show {
            display: block;
        }

        .map-search-item {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 13px;
            border-bottom: 1px solid #eee;
        }

        .map-search-item:hover {
            background: #f0f7ff;
        }

        .map-search-item:last-child {
            border-bottom: none;
        }
    </style>
}

@section Scripts {
    <script src="~/js/view-hub.js" asp-append-version="true"></script>
    <script>
        var mapViewInstance = null;

        class MapViewManager {
            static LEAFLET_CSS = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
            static LEAFLET_JS = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";

            constructor(options) {
                this.viewID = options.viewID;
                this.refreshRate = options.refreshRate || 1000;
                this.rootPath = this._detectRootPath();
                this.map = null;
                this.markers = [];        // raw marker defs from API
                this.markerEntries = [];   // {id, def, leafletMarker}
                this.updateTimer = null;
                this.curDataMap = {};       // cnlNum -> record
            }

            _detectRootPath() {
                let b = document.querySelector("base");
                return b ? b.getAttribute("href") : "/";
            }

            _apiRoot() {
                return this.rootPath + "Api/Map/";
            }

            _loadLeafletCss() {
                return new Promise((resolve) => {
                    if (document.querySelector('link[href*="leaflet"]')) { resolve(); return; }
                    let link = document.createElement("link");
                    link.rel = "stylesheet";
                    link.href = MapViewManager.LEAFLET_CSS;
                    link.integrity = "sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=";
                    link.crossOrigin = "";
                    link.onload = resolve;
                    document.head.appendChild(link);
                });
            }

            _loadLeafletJs() {
                return new Promise((resolve, reject) => {
                    if (typeof L !== "undefined") { resolve(); return; }
                    let script = document.createElement("script");
                    script.src = MapViewManager.LEAFLET_JS;
                    script.integrity = "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=";
                    script.crossOrigin = "";
                    script.onload = resolve;
                    script.onerror = reject;
                    document.head.appendChild(script);
                });
            }

            _createMarkerIcon(color) {
                color = color || "#3388ff";
                let svg = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">' +
                    '<circle cx="12" cy="12" r="10" fill="' + color + '" stroke="#fff" stroke-width="2"/>' +
                    '</svg>';
                return L.divIcon({
                    html: svg,
                    className: "map-marker-icon",
                    iconSize: [24, 24],
                    iconAnchor: [12, 12],
                    popupAnchor: [0, -14]
                });
            }

            async init() {
                await this._loadLeafletCss();
                await this._loadLeafletJs();

                let response = await fetch(this._apiRoot() + "GetMapData?viewID=" + this.viewID);
                let dto = await response.json();

                if (!dto.ok) {
                    console.error("Failed to load map data:", dto.msg);
                    document.getElementById("divMapContainer").textContent = "Error: " + dto.msg;
                    return;
                }

                let config = dto.data.config;
                this.markers = dto.data.markers;

                this.map = L.map("divMapContainer", {
                    minZoom: config.minZoom,
                    maxZoom: config.maxZoom
                }).setView([config.centerLat, config.centerLng], config.zoom);

                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    attribution: '',
                    maxZoom: config.maxZoom
                }).addTo(this.map);

                this.markerEntries = [];

                for (let m of this.markers) {
                    let lMarker = L.marker([m.lat, m.lng], {
                        icon: this._createMarkerIcon(null),
                        title: m.name
                    }).addTo(this.map);

                    lMarker.bindPopup(this._buildPopupHtml(m));

                    this.markerEntries.push({ id: m.id, def: m, leafletMarker: lMarker });
                }

                this._initSearch();
                this._refreshData();
                this.updateTimer = setInterval(() => this._refreshData(), this.refreshRate);
            }

            // --- Search ---
            _initSearch() {
                let input = document.getElementById("mapSearchInput");
                let results = document.getElementById("mapSearchResults");
                if (!input || !results) return;

                input.addEventListener("input", () => {
                    let query = input.value.trim().toLowerCase();
                    if (query.length === 0) {
                        results.classList.remove("show");
                        results.innerHTML = "";
                        return;
                    }

                    let matches = this.markerEntries.filter(e =>
                        e.def.name.toLowerCase().includes(query)
                    );

                    if (matches.length === 0) {
                        results.innerHTML = '<div class="map-search-item" style="color:#999">No results</div>';
                        results.classList.add("show");
                        return;
                    }

                    results.innerHTML = matches.slice(0, 20).map(e =>
                        '<div class="map-search-item" data-marker-id="' + e.id + '">' +
                        this._escapeHtml(e.def.name) + '</div>'
                    ).join("");
                    results.classList.add("show");
                });

                results.addEventListener("click", (ev) => {
                    let item = ev.target.closest(".map-search-item");
                    if (!item || !item.dataset.markerId) return;

                    let id = parseInt(item.dataset.markerId, 10);
                    let entry = this.markerEntries.find(e => e.id === id);
                    if (entry) {
                        this.map.setView(entry.leafletMarker.getLatLng(), 15);
                        entry.leafletMarker.openPopup();
                    }

                    results.classList.remove("show");
                    input.value = "";
                });

                // close results on outside click
                document.addEventListener("click", (ev) => {
                    if (!ev.target.closest(".map-search-container")) {
                        results.classList.remove("show");
                    }
                });
            }

            // --- Popups ---
            _buildPopupHtml(def) {
                let html = '<b>' + this._escapeHtml(def.name) + '</b>';

                if (def.channels && def.channels.length > 0) {
                    html += '<table class="map-popup-table">';
                    for (let ch of def.channels) {
                        let rec = this.curDataMap[ch.cnlNum];
                        let valText = rec ? this._escapeHtml(rec.text) : "--";
                        html += '<tr>' +
                            '<td class="alias">' + this._escapeHtml(ch.alias || "Ch" + ch.cnlNum) + ':</td>' +
                            '<td class="val" id="cnl-' + ch.cnlNum + '">' + valText + '</td>' +
                            '</tr>';
                    }
                    html += '</table>';

                    // chart link opens all channels at once
                    let cnlNums = def.channels.map(c => c.cnlNum).join(",");
                    html += '<a class="map-popup-chart-link" href="javascript:void(0)" ' +
                        'onclick="mapViewInstance._openChart(\'' + cnlNums + '\')">&#128200; Chart</a>';
                }

                return html;
            }

            _openChart(cnlNums) {
                if (typeof viewHub !== "undefined" && viewHub.features && viewHub.features.chart) {
                    viewHub.features.chart.show(cnlNums);
                } else {
                    window.open(this.rootPath + "Chart/Chart?cnlNums=" + cnlNums + "&startDate=");
                }
            }

            // --- Data refresh ---
            _refreshData() {
                fetch(this._apiRoot() + "GetCurData?viewID=" + this.viewID)
                    .then(r => r.json())
                    .then(dto => {
                        if (dto.ok) {
                            this._updateMarkers(dto.data.records);
                        }
                    })
                    .catch(err => console.error("Map data refresh error:", err));
            }

            _updateMarkers(records) {
                // update data map
                for (let rec of records) {
                    this.curDataMap[rec.cnlNum] = rec;
                }

                for (let entry of this.markerEntries) {
                    // determine worst status across all channels
                    let worstStat = 0;
                    for (let ch of entry.def.channels) {
                        let rec = this.curDataMap[ch.cnlNum];
                        if (rec && rec.stat > worstStat) {
                            worstStat = rec.stat;
                        }
                    }

                    let color = this._getColorForStatus(worstStat);
                    entry.leafletMarker.setIcon(this._createMarkerIcon(color));
                    entry.leafletMarker.setPopupContent(this._buildPopupHtml(entry.def));
                }
            }

            _getColorForStatus(stat) {
                switch (stat) {
                    case 0:   return "#999";
                    case 2:   return "#28a745";
                    case 3:   return "#ffc107";
                    case 4:   return "#dc3545";
                    case 5:   return "#dc3545";
                    default:  return "#3388ff";
                }
            }

            _escapeHtml(text) {
                if (!text) return "";
                let div = document.createElement("div");
                div.appendChild(document.createTextNode(text));
                return div.innerHTML;
            }

            destroy() {
                if (this.updateTimer) { clearInterval(this.updateTimer); this.updateTimer = null; }
                if (this.map) { this.map.remove(); this.map = null; }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            var container = document.getElementById("divMapContainer");
            if (container && container.dataset.viewId) {
                var options = {
                    viewID: parseInt(container.dataset.viewId, 10),
                    refreshRate: parseInt(container.dataset.refreshRate, 10) || 1000
                };
                mapViewInstance = new MapViewManager(options);
                mapViewInstance.init().catch(function (error) {
                    console.error("Map initialization failed:", error);
                });
            }
        });
    </script>
}

<div class="map-search-container">
    <input type="text" id="mapSearchInput" class="map-search-input"
           placeholder="Search markers..." autocomplete="off" />
    <div id="mapSearchResults" class="map-search-results"></div>
</div>

<div id="divMapContainer" class="map-container"
     data-view-id="@Model.ViewID"
     data-refresh-rate="@Model.RefreshRate"></div>
