@page "{id:int?}"
@model Scada.Web.Plugins.PlgMap.Areas.Map.Pages.MapViewModel
@{
    Layout = "_BasicLayout";
}

@section Styles {
    <style>
        html, body {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .map-container {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 1;
        }

        .map-marker-icon {
            background: none !important;
            border: none !important;
        }

        /* Blinking red outline for markers with active statuses */
        .map-marker-alert {
            animation: markerBlink 1.2s ease-in-out infinite;
        }
        @@keyframes markerBlink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.45; }
        }

        /* Popup — clean fonts */
        .leaflet-popup-content {
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            font-size: 13px;
            line-height: 1.4;
            margin: 8px 12px;
        }

        .map-popup-table {
            border-collapse: collapse;
            font-size: 13px;
            margin: 4px 0;
            width: 100%;
        }

        .map-popup-table td {
            padding: 2px 8px 2px 0;
        }

        .map-popup-table .alias {
            color: #666;
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        .map-popup-table .val {
            font-weight: 600;
            color: #222;
        }

        .map-popup-table .chart-btn {
            cursor: pointer;
            opacity: 0.5;
            padding: 0 3px;
            vertical-align: middle;
            transition: opacity 0.15s;
        }

        .map-popup-table .chart-btn:hover {
            opacity: 1.0;
        }

        .map-popup-name {
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            font-size: 14px;
            font-weight: 700;
            display: block;
            text-align: center;
            color: #1a1a1a;
            letter-spacing: 0.01em;
        }

        .map-popup-descr {
            font-size: 12px;
            color: #666;
            margin: 2px 0 4px 0;
            text-align: center;
        }

        .map-popup-chart-btn {
            display: block;
            margin-top: 6px;
            padding: 5px 10px;
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            color: #fff;
            background: #0073aa;
            border: none;
            border-radius: 4px;
            text-align: center;
            width: 100%;
            box-sizing: border-box;
        }

        .map-popup-chart-btn:hover {
            background: #005f8a;
        }

        .leaflet-control-attribution {
            display: none !important;
        }

        /* Status tooltip below marker */
        .map-status-tooltip {
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            padding: 6px 10px !important;
            border-radius: 6px !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2) !important;
            font-size: 12px;
        }
        .map-status-list {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .map-status-row {
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }
        .map-status-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 1.5px solid rgba(0,0,0,0.25);
            flex-shrink: 0;
        }
        .map-status-label {
            color: #333;
        }

        /* Status panel button + dropdown (right of search bar) */
        .map-status-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 1000;
        }
        .map-status-btn button {
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            padding: 7px 14px;
            font-size: 13px;
            font-weight: 600;
            border: 2px solid rgba(0,0,0,0.2);
            border-radius: 4px;
            background: #fff;
            cursor: pointer;
            box-shadow: 0 1px 5px rgba(0,0,0,0.2);
            color: #333;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .map-status-btn button:hover {
            background: #f5f5f5;
        }
        .map-status-btn button .status-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #d32f2f;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            min-width: 18px;
            height: 18px;
            border-radius: 9px;
            padding: 0 5px;
        }
        .map-status-btn button .status-count.hidden {
            display: none;
        }
        .map-status-panel {
            display: none;
            position: absolute;
            top: 100%;
            right: 0;
            margin-top: 4px;
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.18);
            min-width: 280px;
            max-width: 380px;
            max-height: 400px;
            overflow-y: auto;
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            font-size: 13px;
        }
        .map-status-panel.show {
            display: block;
        }
        .map-status-panel-empty {
            padding: 16px;
            text-align: center;
            color: #999;
        }
        .map-status-panel-item {
            padding: 8px 12px;
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
        }
        .map-status-panel-item:hover {
            background: #f5f9ff;
        }
        .map-status-panel-item:last-child {
            border-bottom: none;
        }
        .map-status-panel-name {
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: 4px;
        }
        .map-status-panel-dots {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }
        .map-status-panel-dot {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            color: #555;
        }
        .map-status-panel-dot .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            border: 1.5px solid rgba(0,0,0,0.2);
            flex-shrink: 0;
        }

        /* Search bar */
        .map-search-container {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            width: 320px;
        }

        .map-search-input {
            width: 100%;
            padding: 8px 12px;
            border: 2px solid rgba(0,0,0,0.2);
            border-radius: 4px;
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            font-size: 14px;
            outline: none;
            box-shadow: 0 1px 5px rgba(0,0,0,0.2);
            box-sizing: border-box;
        }

        .map-search-input:focus {
            border-color: #0073aa;
        }

        .map-search-results {
            background: #fff;
            border: 1px solid #ccc;
            border-top: none;
            border-radius: 0 0 4px 4px;
            max-height: 250px;
            overflow-y: auto;
            display: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .map-search-results.show {
            display: block;
        }

        .map-search-item {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 13px;
            border-bottom: 1px solid #eee;
        }

        .map-search-item:hover {
            background: #f0f7ff;
        }

        .map-search-item:last-child {
            border-bottom: none;
        }

        /* Chart overlay panel */
        .map-chart-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.45);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .map-chart-overlay.show {
            display: flex;
        }

        .map-chart-panel {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            width: 94vw;
            max-width: 94vw;
            height: 90vh;
            max-height: 90vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .map-chart-header {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px 16px;
            border-bottom: 1px solid #eee;
            font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            font-weight: 600;
            font-size: 1.1em;
            position: relative;
        }

        .map-chart-header #mapChartClose {
            position: absolute;
            right: 16px;
        }

        .map-chart-close {
            cursor: pointer;
            font-size: 24px;
            color: #888;
            line-height: 1;
            padding: 0 4px;
        }

        .map-chart-close:hover {
            color: #333;
        }

        .map-chart-toolbar {
            display: flex;
            gap: 4px;
            padding: 8px 16px;
            border-bottom: 1px solid #f0f0f0;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
        }

        .map-chart-toolbar label {
            font-size: 13px;
            color: #666;
            margin-right: 4px;
        }

        .map-chart-period-btn {
            padding: 4px 10px;
            font-size: 12px;
            border: 1px solid #ccc;
            border-radius: 3px;
            background: #fff;
            cursor: pointer;
            color: #333;
        }

        .map-chart-period-btn:hover {
            background: #f0f7ff;
        }

        .map-chart-period-btn.active {
            background: #0073aa;
            color: #fff;
            border-color: #0073aa;
        }

        .map-chart-body {
            padding: 12px 16px;
            flex: 1;
            overflow: hidden;
        }

        .map-chart-canvas-wrap {
            position: relative;
            width: 100%;
            height: 100%;
            min-height: 300px;
        }

        .map-chart-loading {
            text-align: center;
            color: #999;
            padding: 40px;
            font-size: 0.95em;
        }

        /* Hover mini-chart tooltip */
        .map-minichart-tooltip {
            display: none;
            position: fixed;
            z-index: 3000;
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.2);
            padding: 8px;
            width: 360px;
        }

        .map-minichart-tooltip.show {
            display: block;
        }

        .map-minichart-title {
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 4px;
            color: #333;
        }

        .map-minichart-canvas-wrap {
            width: 100%;
            height: 170px;
            position: relative;
        }

        .map-minichart-loading {
            text-align: center;
            color: #999;
            padding: 20px 0;
            font-size: 0.85em;
        }
    </style>
}

@section Scripts {
    <script src="~/js/view-hub.js" asp-append-version="true"></script>
    <script>
        var mapViewInstance = null;

        class MapViewManager {
            static LEAFLET_CSS = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
            static LEAFLET_JS = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
            static CHARTJS_URL = "https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js";
            static CHARTJS_ADAPTER_URL = "https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js";
            static CHART_COLORS = [
                "#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd",
                "#8c564b", "#e377c2", "#7f7f7f", "#bcbd22", "#17becf"
            ];

            // --- Localization (from SCADA language settings) ---
            static LANG = {
                searchPlaceholder: "@Html.Raw(Model.JsDict.SearchPlaceholder)",
                noResults: "@Html.Raw(Model.JsDict.NoResults)",
                combinedChart: "@Html.Raw(Model.JsDict.CombinedChart)",
                loading: "@Html.Raw(Model.JsDict.Loading)",
                loadingChart: "@Html.Raw(Model.JsDict.LoadingChart)",
                noData: "@Html.Raw(Model.JsDict.NoData)",
                errorChart: "@Html.Raw(Model.JsDict.ErrorChart)",
                error: "@Html.Raw(Model.JsDict.Error)",
                errorPrefix: "@Html.Raw(Model.JsDict.ErrorPrefix)",
                period: "@Html.Raw(Model.JsDict.Period)",
                day1: "@Html.Raw(Model.JsDict.Day1)",
                day3: "@Html.Raw(Model.JsDict.Day3)",
                day7: "@Html.Raw(Model.JsDict.Day7)",
                ago1h: "@Html.Raw(Model.JsDict.Ago1h)",
                now: "@Html.Raw(Model.JsDict.Now)",
                channel: "@Html.Raw(Model.JsDict.Channel)",
                details: "@Html.Raw(Model.JsDict.Details)",
                pressureUnit: "@Html.Raw(Model.JsDict.PressureUnit)",
                statusesLabel: "@Html.Raw(Model.JsDict.StatusesLabel)"
            };

            constructor(options) {
                this.viewID = options.viewID;
                this.refreshRate = options.refreshRate || 1000;
                this.rootPath = this._detectRootPath();
                this.map = null;
                this.markers = [];
                this.markerEntries = [];
                this.updateTimer = null;
                this.curDataMap = {};
                this._chartJsLoaded = false;
                this._chartCache = {};
                this._activeChart = null;
                this._activeMiniChart = null;
                this._miniChartHideTimer = null;
                this._combinedMarkerIdx = -1;
                this._combinedDays = 1;
                this.t = MapViewManager.LANG;
            }

            _detectRootPath() {
                let b = document.querySelector("base");
                return b ? b.getAttribute("href") : "/";
            }

            _apiRoot() { return this.rootPath + "Api/Map/"; }
            _mainApiRoot() { return this.rootPath + "Api/Main/"; }

            _fmtDateTime(d) {
                let dd = String(d.getDate()).padStart(2, '0');
                let mm = String(d.getMonth() + 1).padStart(2, '0');
                let hh = String(d.getHours()).padStart(2, '0');
                let mi = String(d.getMinutes()).padStart(2, '0');
                return dd + '.' + mm + ' ' + hh + ':' + mi;
            }

            _fmtTime(d) {
                let hh = String(d.getHours()).padStart(2, '0');
                let mi = String(d.getMinutes()).padStart(2, '0');
                return hh + ':' + mi;
            }

            // --- Resource loading ---
            _loadLeafletCss() {
                return new Promise((resolve) => {
                    if (document.querySelector('link[href*="leaflet"]')) { resolve(); return; }
                    let link = document.createElement("link");
                    link.rel = "stylesheet";
                    link.href = MapViewManager.LEAFLET_CSS;
                    link.integrity = "sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=";
                    link.crossOrigin = "";
                    link.onload = resolve;
                    document.head.appendChild(link);
                });
            }

            _loadLeafletJs() {
                return new Promise((resolve, reject) => {
                    if (typeof L !== "undefined") { resolve(); return; }
                    let script = document.createElement("script");
                    script.src = MapViewManager.LEAFLET_JS;
                    script.integrity = "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=";
                    script.crossOrigin = "";
                    script.onload = resolve;
                    script.onerror = reject;
                    document.head.appendChild(script);
                });
            }

            _loadChartJs() {
                if (this._chartJsLoadPromise) return this._chartJsLoadPromise;
                this._chartJsLoadPromise = new Promise((resolve, reject) => {
                    if (this._chartJsLoaded || typeof Chart !== "undefined") {
                        this._chartJsLoaded = true;
                        resolve();
                        return;
                    }
                    let script = document.createElement("script");
                    script.src = MapViewManager.CHARTJS_URL;
                    script.onload = () => {
                        let adapter = document.createElement("script");
                        adapter.src = MapViewManager.CHARTJS_ADAPTER_URL;
                        adapter.onload = () => { this._chartJsLoaded = true; resolve(); };
                        adapter.onerror = reject;
                        document.head.appendChild(adapter);
                    };
                    script.onerror = reject;
                    document.head.appendChild(script);
                });
                return this._chartJsLoadPromise;
            }

            // --- Marker icons (zoom-dependent size) ---
            _getMarkerSize() {
                if (!this.map) return 16;
                let z = this.map.getZoom();
                // smaller range: 6px at zoom 5, 12px at zoom 10, 18px at zoom 14, 22px at zoom 18
                return Math.round(Math.min(22, Math.max(6, z * 1.4 - 1)));
            }

            _createMarkerIcon(color, hasAlert) {
                color = color || "#3388ff";
                let size = this._getMarkerSize();
                let r = Math.round(size * 0.42);
                let sw = Math.max(1.5, size * 0.08);
                let half = size / 2;
                let outlineColor = hasAlert ? "#d32f2f" : "#fff";
                let outlineSw = hasAlert ? Math.max(2.5, size * 0.14) : sw;
                let svg = '<svg xmlns="http://www.w3.org/2000/svg" width="' + size + '" height="' + size + '" viewBox="0 0 ' + size + ' ' + size + '">' +
                    '<circle cx="' + half + '" cy="' + half + '" r="' + r + '" fill="' + color + '" stroke="' + outlineColor + '" stroke-width="' + outlineSw + '"/>' +
                    '</svg>';
                let cls = "map-marker-icon" + (hasAlert ? " map-marker-alert" : "");
                return L.divIcon({
                    html: svg,
                    className: cls,
                    iconSize: [size, size],
                    iconAnchor: [half, half],
                    popupAnchor: [0, -half - 2]
                });
            }

            // Check if marker has any active status (val >= 1)
            _hasActiveStatus(def) {
                let stCh = def.statusChannels;
                if (!stCh || stCh.length === 0) return false;
                for (let ch of stCh) {
                    let rec = this.curDataMap[ch.cnlNum];
                    if (rec && rec.val >= 1) return true;
                }
                return false;
            }

            // Returns status dot data from statusChannels
            _getStatusDots(def) {
                let stCh = def.statusChannels;
                if (!stCh || stCh.length === 0) return [];
                return stCh.map(ch => {
                    let rec = this.curDataMap[ch.cnlNum];
                    return { alias: ch.alias, on: !!(rec && rec.val >= 1), cnlNum: ch.cnlNum };
                });
            }

            _refreshAllMarkerIcons() {
                for (let entry of this.markerEntries) {
                    let color = this._getMarkerColor(entry.def);
                    let alert = this._hasActiveStatus(entry.def);
                    entry.leafletMarker.setIcon(this._createMarkerIcon(color, alert));
                }
            }

            // --- Axis helpers ---
            _getAxisLimits(alias) {
                let a = (alias || "").toUpperCase();
                if (a === "T1" || a === "T2") return { min: 0, max: 120, unit: "°C" };
                if (a === "T3")               return { min: 0, max: 80,  unit: "°C" };
                if (a === "P1" || a === "P2") return { min: 0, max: 25,  unit: this.t.pressureUnit };
                return null;
            }

            _getAxisGroup(alias) {
                let a = (alias || "").toUpperCase();
                if (a === "P1" || a === "P2") return "pressure";
                return "temp";
            }

            // --- Init ---
            async init() {
                await this._loadLeafletCss();
                await this._loadLeafletJs();

                let response = await fetch(this._apiRoot() + "GetMapData?viewID=" + this.viewID);
                let dto = await response.json();

                if (!dto.ok) {
                    console.error("Failed to load map data:", dto.msg);
                    document.getElementById("divMapContainer").textContent = this.t.errorPrefix + dto.msg;
                    return;
                }

                let config = dto.data.config;
                this.markers = dto.data.markers;

                // set search placeholder
                let searchInput = document.getElementById("mapSearchInput");
                if (searchInput) searchInput.placeholder = this.t.searchPlaceholder;

                this.map = L.map("divMapContainer", {
                    minZoom: config.minZoom,
                    maxZoom: config.maxZoom
                }).setView([config.centerLat, config.centerLng], config.zoom);

                let tileUrl = config.tileUrlTemplate || "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png";
                L.tileLayer(tileUrl, {
                    attribution: '',
                    maxZoom: config.maxZoom
                }).addTo(this.map);

                this.markerEntries = [];

                for (let i = 0; i < this.markers.length; i++) {
                    let m = this.markers[i];
                    if (!m.name && m.caption) m.name = m.caption;
                    if (!m.name) m.name = "";
                    if (!m.id) m.id = i + 1;
                    if (!m.channels || m.channels.length === 0) {
                        if (m.cnlNum) {
                            m.channels = [{ cnlNum: m.cnlNum, alias: m.caption || "" }];
                        } else {
                            m.channels = [];
                        }
                    }
                    if (!m.statusChannels) m.statusChannels = [];

                    let lMarker = L.marker([m.lat, m.lng], {
                        icon: this._createMarkerIcon(null),
                        title: m.name
                    }).addTo(this.map);

                    lMarker.bindPopup(this._buildPopupHtml(m), { maxWidth: 280, minWidth: 140 });

                    this.markerEntries.push({ id: m.id, def: m, leafletMarker: lMarker });
                }

                // resize markers on zoom
                this.map.on('zoomend', () => this._refreshAllMarkerIcons());

                this._initSearch();
                this._initChartOverlay();
                this._initMiniChartTooltip();
                this._initStatusPanel();
                this._refreshData();
                this.updateTimer = setInterval(() => this._refreshData(), this.refreshRate);
            }

            // --- Search ---
            _initSearch() {
                let input = document.getElementById("mapSearchInput");
                let results = document.getElementById("mapSearchResults");
                if (!input || !results) return;

                input.addEventListener("input", () => {
                    let query = input.value.trim().toLowerCase();
                    if (query.length === 0) {
                        results.classList.remove("show");
                        results.innerHTML = "";
                        return;
                    }

                    let matches = this.markerEntries.filter(e =>
                        e.def.name.toLowerCase().includes(query)
                    );

                    if (matches.length === 0) {
                        results.innerHTML = '<div class="map-search-item" style="color:#999">' +
                            this._escapeHtml(this.t.noResults) + '</div>';
                        results.classList.add("show");
                        return;
                    }

                    results.innerHTML = matches.slice(0, 20).map(e =>
                        '<div class="map-search-item" data-marker-id="' + e.id + '">' +
                        this._escapeHtml(e.def.name) + '</div>'
                    ).join("");
                    results.classList.add("show");
                });

                results.addEventListener("click", (ev) => {
                    let item = ev.target.closest(".map-search-item");
                    if (!item || !item.dataset.markerId) return;

                    let id = parseInt(item.dataset.markerId, 10);
                    let entry = this.markerEntries.find(e => e.id === id);
                    if (entry) {
                        this.map.setView(entry.leafletMarker.getLatLng(), 15);
                        entry.leafletMarker.openPopup();
                    }

                    results.classList.remove("show");
                    input.value = "";
                });

                document.addEventListener("click", (ev) => {
                    if (!ev.target.closest(".map-search-container")) {
                        results.classList.remove("show");
                    }
                });
            }

            // --- Status Panel (persistent button top-right) ---
            _initStatusPanel() {
                let btn = document.getElementById("mapStatusBtn");
                let panel = document.getElementById("mapStatusPanel");
                if (!btn || !panel) return;

                btn.addEventListener("click", () => {
                    panel.classList.toggle("show");
                });

                document.addEventListener("click", (ev) => {
                    if (!ev.target.closest(".map-status-btn")) {
                        panel.classList.remove("show");
                    }
                });

                panel.addEventListener("click", (ev) => {
                    let item = ev.target.closest(".map-status-panel-item");
                    if (!item || !item.dataset.markerId) return;
                    let id = parseInt(item.dataset.markerId, 10);
                    let entry = this.markerEntries.find(e => e.id === id);
                    if (entry) {
                        this.map.setView(entry.leafletMarker.getLatLng(), 15);
                        entry.leafletMarker.openPopup();
                    }
                });
            }

            _updateStatusPanel() {
                let panel = document.getElementById("mapStatusPanel");
                let countEl = document.getElementById("mapStatusCount");
                if (!panel || !countEl) return;

                let problemEntries = [];
                for (let entry of this.markerEntries) {
                    let dots = this._getStatusDots(entry.def);
                    let active = dots.filter(d => d.on);
                    if (active.length > 0) {
                        problemEntries.push({ entry, dots, activeCount: active.length });
                    }
                }

                if (problemEntries.length === 0) {
                    countEl.classList.add("hidden");
                    panel.innerHTML = '<div class="map-status-panel-empty">' +
                        this._escapeHtml(this.t.noResults) + '</div>';
                    return;
                }

                countEl.textContent = problemEntries.length;
                countEl.classList.remove("hidden");

                let html = '';
                for (let pe of problemEntries) {
                    html += '<div class="map-status-panel-item" data-marker-id="' + pe.entry.id + '">';
                    html += '<div class="map-status-panel-name">' + this._escapeHtml(pe.entry.def.name) + '</div>';
                    html += '<div class="map-status-panel-dots">';
                    for (let d of pe.dots) {
                        let color = d.on ? "#d32f2f" : "#999";
                        html += '<span class="map-status-panel-dot">' +
                            '<span class="dot" style="background:' + color + '"></span>' +
                            this._escapeHtml(d.alias) + '</span>';
                    }
                    html += '</div></div>';
                }
                panel.innerHTML = html;
            }

            // --- Popups (clean fonts, button for combined chart) ---
            _buildPopupHtml(def) {
                let html = '<span class="map-popup-name">' + this._escapeHtml(def.name) + '</span>';
                if (def.descr) {
                    html += '<div class="map-popup-descr">' + this._escapeHtml(def.descr) + '</div>';
                }

                if (def.channels && def.channels.length > 0) {
                    html += '<table class="map-popup-table">';
                    for (let i = 0; i < def.channels.length; i++) {
                        let ch = def.channels[i];
                        let rec = this.curDataMap[ch.cnlNum];
                        let valText = rec ? this._escapeHtml(rec.text) : "--";
                        let alias = ch.alias || (this.t.channel + ch.cnlNum);
                        let color = MapViewManager.CHART_COLORS[i % MapViewManager.CHART_COLORS.length];

                        html += '<tr>' +
                            '<td class="alias">' + this._escapeHtml(alias) + '</td>' +
                            '<td class="val" data-cnl="' + ch.cnlNum + '">' + valText + '</td>' +
                            '<td class="chart-btn" ' +
                                'onmouseenter="mapViewInstance._showMiniChart(event, ' + ch.cnlNum + ', \'' +
                                    this._escapeHtml(alias).replace(/'/g, "\\'") + '\', \'' + color + '\')" ' +
                                'onmouseleave="mapViewInstance._scheduleMiniChartHide()">' +
                                '<svg width="16" height="16" viewBox="0 0 14 14" style="vertical-align:middle">' +
                                '<polyline points="1,12 4,6 7,9 10,3 13,7" fill="none" stroke="' + color + '" stroke-width="1.5"/>' +
                                '</svg>' +
                            '</td>' +
                            '</tr>';
                    }
                    html += '</table>';

                    let markerIdx = this.markerEntries.findIndex(e => e.def === def);
                    if (markerIdx < 0) markerIdx = this.markers.indexOf(def);
                    html += '<button class="map-popup-chart-btn" ' +
                        'onclick="mapViewInstance._openCombinedChart(' + (markerIdx >= 0 ? markerIdx : 0) + ')">' +
                        this._escapeHtml(this.t.combinedChart) + '</button>';
                }

                return html;
            }

            // --- Chart Overlay (Combined) ---
            _initChartOverlay() {
                let overlay = document.getElementById("mapChartOverlay");
                if (!overlay) return;

                overlay.addEventListener("click", (ev) => {
                    if (ev.target === overlay) this._closeChartOverlay();
                });

                document.getElementById("mapChartClose").addEventListener("click", () => {
                    this._closeChartOverlay();
                });
            }

            _closeChartOverlay() {
                let overlay = document.getElementById("mapChartOverlay");
                overlay.classList.remove("show");
                if (this._activeChart) {
                    this._activeChart.destroy();
                    this._activeChart = null;
                }
            }

            async _openCombinedChart(markerIdx, days) {
                let def = this.markers[markerIdx];
                if (!def || !def.channels || def.channels.length === 0) return;

                this._combinedMarkerIdx = markerIdx;
                this._combinedDays = days || 1;

                let overlay = document.getElementById("mapChartOverlay");
                let title = document.getElementById("mapChartTitle");
                let body = document.getElementById("mapChartBody");
                let toolbar = document.getElementById("mapChartToolbar");

                title.textContent = def.name || this.t.combinedChart;

                // build period toolbar
                toolbar.innerHTML = '<label>' + this._escapeHtml(this.t.period) + '</label>';
                let periods = [
                    { days: 1, label: this.t.day1 },
                    { days: 3, label: this.t.day3 },
                    { days: 7, label: this.t.day7 }
                ];
                for (let p of periods) {
                    let cls = p.days === this._combinedDays ? "map-chart-period-btn active" : "map-chart-period-btn";
                    toolbar.innerHTML += '<button class="' + cls + '" data-days="' + p.days + '">' +
                        this._escapeHtml(p.label) + '</button>';
                }

                // wire period buttons
                toolbar.querySelectorAll('.map-chart-period-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        let d = parseInt(btn.dataset.days, 10);
                        this._openCombinedChart(this._combinedMarkerIdx, d);
                    });
                });

                body.innerHTML = '<div class="map-chart-loading">' + this._escapeHtml(this.t.loadingChart) + '</div>';
                overlay.classList.add("show");

                try {
                    await this._loadChartJs();
                    let cnlNums = def.channels.map(c => c.cnlNum);
                    let histData = await this._fetchHistData(cnlNums, this._combinedDays);

                    if (!histData) {
                        body.innerHTML = '<div class="map-chart-loading">' + this._escapeHtml(this.t.noData) + '</div>';
                        return;
                    }

                    body.innerHTML = '<div class="map-chart-canvas-wrap"><canvas id="mapCombinedCanvas"></canvas></div>';
                    let canvas = document.getElementById("mapCombinedCanvas");
                    this._renderCombinedChart(canvas, def, histData);
                } catch (err) {
                    console.error("Chart loading error:", err);
                    body.innerHTML = '<div class="map-chart-loading">' + this._escapeHtml(this.t.errorChart) + '</div>';
                }
            }

            _renderCombinedChart(canvas, def, histData) {
                if (this._activeChart) {
                    this._activeChart.destroy();
                    this._activeChart = null;
                }

                let timestamps = histData.timestamps.map(t => new Date(t.ms));
                let datasets = [];

                let cnlToTrendIdx = {};
                for (let i = 0; i < histData.cnlNums.length; i++) {
                    cnlToTrendIdx[histData.cnlNums[i]] = i;
                }

                for (let i = 0; i < def.channels.length; i++) {
                    let ch = def.channels[i];
                    let alias = ch.alias || (this.t.channel + ch.cnlNum);
                    let color = MapViewManager.CHART_COLORS[i % MapViewManager.CHART_COLORS.length];
                    let trendIdx = cnlToTrendIdx[ch.cnlNum];
                    if (trendIdx === undefined) continue;

                    let trend = histData.trends[trendIdx];
                    let data = trend.map((rec, idx) => ({
                        x: timestamps[idx],
                        y: (rec && rec.d && rec.d.stat > 0) ? rec.d.val : null
                    }));

                    let axisGroup = this._getAxisGroup(alias);

                    datasets.push({
                        label: alias,
                        data: data,
                        borderColor: color,
                        backgroundColor: color + "20",
                        borderWidth: 1.5,
                        pointRadius: 0,
                        pointHoverRadius: 4,
                        tension: 0.3,
                        fill: false,
                        spanGaps: false,
                        yAxisID: axisGroup === "pressure" ? "yPressure" : "yTemp"
                    });
                }

                let self = this;
                let xTimeFormats = this._combinedDays <= 1
                    ? { hour: 'HH:mm', minute: 'HH:mm' }
                    : { hour: 'HH:mm', day: 'dd.MM' };

                this._activeChart = new Chart(canvas, {
                    type: 'line',
                    data: { datasets: datasets },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { usePointStyle: true, pointStyle: 'line', boxWidth: 30, font: { size: 13 } }
                            },
                            tooltip: {
                                titleFont: { size: 13 },
                                bodyFont: { size: 13 },
                                callbacks: {
                                    title: function(items) {
                                        if (items.length > 0) {
                                            return self._fmtDateTime(new Date(items[0].parsed.x));
                                        }
                                        return '';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                type: 'time',
                                time: { displayFormats: xTimeFormats },
                                title: { display: false },
                                ticks: { font: { size: 12 } }
                            },
                            yTemp: {
                                type: 'linear',
                                position: 'left',
                                min: 0,
                                max: 120,
                                title: { display: true, text: '°C', font: { size: 13 } },
                                ticks: { font: { size: 12 } }
                            },
                            yPressure: {
                                type: 'linear',
                                position: 'right',
                                min: 0,
                                max: 25,
                                title: { display: true, text: MapViewManager.LANG.pressureUnit, font: { size: 13 } },
                                ticks: { font: { size: 12 } },
                                grid: { drawOnChartArea: false }
                            }
                        }
                    }
                });
            }

            // --- Mini Chart Tooltip (hover per parameter, 1h range) ---
            _initMiniChartTooltip() {
                let tip = document.getElementById("mapMiniChartTooltip");
                if (!tip) return;

                tip.addEventListener("mouseenter", () => {
                    clearTimeout(this._miniChartHideTimer);
                });
                tip.addEventListener("mouseleave", () => {
                    this._hideMiniChart();
                });
            }

            async _showMiniChart(event, cnlNum, alias, color) {
                clearTimeout(this._miniChartHideTimer);

                let tip = document.getElementById("mapMiniChartTooltip");
                let titleEl = document.getElementById("mapMiniChartTitle");
                let bodyEl = document.getElementById("mapMiniChartBody");

                titleEl.textContent = alias + " (" + this.t.channel + " " + cnlNum + ")";
                bodyEl.innerHTML = '<div class="map-minichart-loading">' + this._escapeHtml(this.t.loading) + '</div>';

                let rect = event.target.getBoundingClientRect();
                let tipWidth = 360;
                let left = rect.right + 8;
                let top = rect.top - 40;

                if (left + tipWidth > window.innerWidth) left = rect.left - tipWidth - 8;
                if (top < 8) top = 8;
                if (top + 210 > window.innerHeight) top = window.innerHeight - 220;

                tip.style.left = left + "px";
                tip.style.top = top + "px";
                tip.classList.add("show");

                try {
                    await this._loadChartJs();
                    // fetch 1 hour for mini chart
                    let histData = await this._fetchHistData([cnlNum], 1 / 24);

                    if (!histData || !histData.trends || histData.trends.length === 0) {
                        bodyEl.innerHTML = '<div class="map-minichart-loading">' + this._escapeHtml(this.t.noData) + '</div>';
                        return;
                    }

                    if (!tip.classList.contains("show")) return;

                    bodyEl.innerHTML = '<div class="map-minichart-canvas-wrap"><canvas id="mapMiniCanvas"></canvas></div>';
                    let canvas = document.getElementById("mapMiniCanvas");
                    this._renderMiniChart(canvas, cnlNum, alias, color, histData);
                } catch (err) {
                    console.error("Mini chart error:", err);
                    bodyEl.innerHTML = '<div class="map-minichart-loading">' + this._escapeHtml(this.t.error) + '</div>';
                }
            }

            _scheduleMiniChartHide() {
                this._miniChartHideTimer = setTimeout(() => this._hideMiniChart(), 300);
            }

            _hideMiniChart() {
                let tip = document.getElementById("mapMiniChartTooltip");
                tip.classList.remove("show");
                if (this._activeMiniChart) {
                    this._activeMiniChart.destroy();
                    this._activeMiniChart = null;
                }
            }

            // Vertical crosshair line plugin for Chart.js
            static _crosshairPlugin = {
                id: 'crosshairLine',
                afterDraw(chart) {
                    if (chart.tooltip && chart.tooltip._active && chart.tooltip._active.length) {
                        let x = chart.tooltip._active[0].element.x;
                        let yAxis = chart.scales.y;
                        let ctx = chart.ctx;
                        ctx.save();
                        ctx.beginPath();
                        ctx.moveTo(x, yAxis.top);
                        ctx.lineTo(x, yAxis.bottom);
                        ctx.lineWidth = 1;
                        ctx.strokeStyle = 'rgba(0,0,0,0.25)';
                        ctx.setLineDash([3, 3]);
                        ctx.stroke();
                        ctx.restore();
                    }
                }
            };

            _renderMiniChart(canvas, cnlNum, alias, color, histData) {
                if (this._activeMiniChart) {
                    this._activeMiniChart.destroy();
                    this._activeMiniChart = null;
                }

                let timestamps = histData.timestamps.map(t => new Date(t.ms));
                let trend = histData.trends[0];
                let data = trend.map((rec, idx) => ({
                    x: timestamps[idx],
                    y: (rec && rec.d && rec.d.stat > 0) ? rec.d.val : null
                }));

                let limits = this._getAxisLimits(alias);
                let yConfig = { ticks: { font: { size: 11 } } };
                if (limits) {
                    yConfig.min = limits.min;
                    yConfig.max = limits.max;
                    yConfig.title = { display: true, text: limits.unit, font: { size: 11 } };
                } else {
                    yConfig.beginAtZero = false;
                    yConfig.title = { display: false };
                }

                // fixed 1-hour range: -1h to now
                let now = new Date();
                let oneHourAgo = new Date(now.getTime() - 60 * 60 * 1000);
                let ago1h = this.t.ago1h;
                let nowLabel = this.t.now;
                let self = this;

                this._activeMiniChart = new Chart(canvas, {
                    type: 'line',
                    data: {
                        datasets: [{
                            label: alias,
                            data: data,
                            borderColor: color,
                            backgroundColor: color + "20",
                            borderWidth: 1.5,
                            pointRadius: 0,
                            pointHoverRadius: 3,
                            tension: 0.3,
                            fill: true,
                            spanGaps: false
                        }]
                    },
                    plugins: [MapViewManager._crosshairPlugin],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 200 },
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                titleFont: { size: 12 },
                                bodyFont: { size: 12 },
                                callbacks: {
                                    title: function(items) {
                                        if (items.length > 0) {
                                            return self._fmtTime(new Date(items[0].parsed.x));
                                        }
                                        return '';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                type: 'time',
                                min: oneHourAgo.getTime(),
                                max: now.getTime(),
                                time: {
                                    displayFormats: { hour: 'HH:mm', minute: 'HH:mm' }
                                },
                                ticks: {
                                    font: { size: 11 },
                                    callback: function(value, index, ticks) {
                                        if (index === 0) return ago1h;
                                        if (index === ticks.length - 1) return nowLabel;
                                        return self._fmtTime(new Date(value));
                                    }
                                },
                                title: { display: false }
                            },
                            y: yConfig
                        }
                    }
                });
            }

            // --- Historical Data Fetch ---
            async _fetchHistData(cnlNums, days) {
                days = days || 1;
                let cacheKey = cnlNums.join(",") + "_" + days;
                let cached = this._chartCache[cacheKey];
                // 60s cache for 1h data, 5min for longer periods
                let cacheMs = days <= 1 / 24 ? 60000 : 300000;
                if (cached && (Date.now() - cached.time) < cacheMs) {
                    return cached.data;
                }

                let endTime = new Date();
                let startTime = new Date(endTime.getTime() - days * 24 * 60 * 60 * 1000);

                let url = this._mainApiRoot() + "GetHistData" +
                    "?archiveBit=1" +
                    "&startTime=" + encodeURIComponent(startTime.toISOString()) +
                    "&endTime=" + encodeURIComponent(endTime.toISOString()) +
                    "&endInclusive=true" +
                    "&cnlNums=" + encodeURIComponent(cnlNums.join(","));

                try {
                    let resp = await fetch(url);
                    let dto = await resp.json();

                    if (dto.ok && dto.data) {
                        this._chartCache[cacheKey] = { data: dto.data, time: Date.now() };
                        return dto.data;
                    }
                } catch (err) {
                    console.error("Failed to fetch hist data:", err);
                }

                return null;
            }

            // --- Data refresh ---
            _refreshData() {
                fetch(this._apiRoot() + "GetCurData?viewID=" + this.viewID)
                    .then(r => r.json())
                    .then(dto => {
                        if (dto.ok) {
                            this._updateMarkers(dto.data.records);
                        }
                    })
                    .catch(err => console.error("Map data refresh error:", err));
            }

            _updateMarkers(records) {
                for (let rec of records) {
                    this.curDataMap[rec.cnlNum] = rec;
                }

                for (let entry of this.markerEntries) {
                    let color = this._getMarkerColor(entry.def);
                    let alert = this._hasActiveStatus(entry.def);
                    entry.leafletMarker.setIcon(this._createMarkerIcon(color, alert));

                    // Update values in-place if popup is open, otherwise rebuild
                    let popup = entry.leafletMarker.getPopup();
                    if (popup && popup.isOpen()) {
                        let popupEl = popup.getElement();
                        if (popupEl) {
                            for (let ch of entry.def.channels) {
                                let valEl = popupEl.querySelector('td[data-cnl="' + ch.cnlNum + '"]');
                                let rec = this.curDataMap[ch.cnlNum];
                                if (valEl && rec) {
                                    valEl.textContent = rec.text || "--";
                                }
                            }
                            continue;
                        }
                    }

                    entry.leafletMarker.setPopupContent(this._buildPopupHtml(entry.def));
                }

                this._updateStatusPanel();
            }

            // Returns aggregate marker color based on how many channels are working.
            // Gray (#999) = no channels working, Yellow (#f0ad4e) = some working,
            // Blue (#3388ff) = all working or single channel working.
            _getMarkerColor(def) {
                let channels = def.channels || [];
                if (channels.length === 0) return "#999";

                let total = channels.length;
                let working = 0;
                for (let ch of channels) {
                    let rec = this.curDataMap[ch.cnlNum];
                    // stat > 0 means the channel has a defined status (working)
                    if (rec && rec.stat > 0) working++;
                }

                if (working === 0) return "#999";      // gray - none working
                if (working < total) return "#f0ad4e";  // amber - partial
                return "#3388ff";                        // blue - all working
            }

            _escapeHtml(text) {
                if (!text) return "";
                let div = document.createElement("div");
                div.appendChild(document.createTextNode(text));
                return div.innerHTML;
            }

            destroy() {
                if (this.updateTimer) { clearInterval(this.updateTimer); this.updateTimer = null; }
                if (this._activeChart) { this._activeChart.destroy(); this._activeChart = null; }
                if (this._activeMiniChart) { this._activeMiniChart.destroy(); this._activeMiniChart = null; }
                if (this.map) { this.map.remove(); this.map = null; }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            var container = document.getElementById("divMapContainer");
            if (container && container.dataset.viewId) {
                var options = {
                    viewID: parseInt(container.dataset.viewId, 10),
                    refreshRate: parseInt(container.dataset.refreshRate, 10) || 1000
                };
                mapViewInstance = new MapViewManager(options);
                mapViewInstance.init().catch(function (error) {
                    console.error("Map initialization failed:", error);
                });
            }
        });
    </script>
}

<div class="map-search-container">
    <input type="text" id="mapSearchInput" class="map-search-input"
           placeholder="@Model.JsDict.SearchPlaceholder" autocomplete="off" />
    <div id="mapSearchResults" class="map-search-results"></div>
</div>

<div class="map-status-btn">
    <button id="mapStatusBtn">
        @Model.JsDict.StatusesLabel
        <span id="mapStatusCount" class="status-count hidden">0</span>
    </button>
    <div id="mapStatusPanel" class="map-status-panel"></div>
</div>

<div id="divMapContainer" class="map-container"
     data-view-id="@Model.ViewID"
     data-refresh-rate="@Model.RefreshRate"></div>

<!-- Combined Chart Overlay -->
<div id="mapChartOverlay" class="map-chart-overlay">
    <div class="map-chart-panel">
        <div class="map-chart-header">
            <span id="mapChartTitle">@Model.JsDict.CombinedChart</span>
            <span id="mapChartClose" class="map-chart-close">&times;</span>
        </div>
        <div id="mapChartToolbar" class="map-chart-toolbar"></div>
        <div id="mapChartBody" class="map-chart-body">
            <div class="map-chart-loading">@Model.JsDict.Loading</div>
        </div>
    </div>
</div>

<!-- Mini Chart Tooltip (hover) -->
<div id="mapMiniChartTooltip" class="map-minichart-tooltip">
    <div id="mapMiniChartTitle" class="map-minichart-title"></div>
    <div id="mapMiniChartBody"></div>
</div>
